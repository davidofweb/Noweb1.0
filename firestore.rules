rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 256 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Helpers
    function isValidBookmark(data) {
      return data.keys().hasAll(['userId', 'name', 'address', 'category', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.address is string && data.address.size() > 0 && data.address.size() <= 1000 &&
             data.category is string && data.category.size() <= 100 &&
             data.createdAt is timestamp &&
             (!data.keys().contains('socialMedia') || data.socialMedia is map) &&
             (!data.keys().contains('attributes') || data.attributes is map) &&
             (!data.keys().contains('hasWebsite') || data.hasWebsite is bool) &&
             (!data.keys().contains('notes') || data.notes is string) &&
             (!data.keys().contains('email') || data.email is string);
    }

    function isValidSearchHistory(data) {
      return data.keys().hasAll(['userId', 'category', 'location', 'resultsCount', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.category is string && data.category.size() <= 100 &&
             data.location is string && data.location.size() <= 200 &&
             data.resultsCount is int &&
             data.createdAt is timestamp;
    }

    // Rules for User data
    match /users/{userId} {
      // Bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBookmark(request.resource.data) && isValidId(bookmarkId);
        allow update: if isOwner(userId) && isValidBookmark(request.resource.data) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'address', 'phone', 'email', 'category', 'hasWebsite', 'socialMedia', 'attributes', 'notes', 'updatedAt', 'createdAt'])
        );
        allow delete: if isOwner(userId);
      }

      // History subcollection
      match /history/{historyId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSearchHistory(request.resource.data) && isValidId(historyId);
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }
  }
}
